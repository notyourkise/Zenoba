// Netloka - Prisma Schema
// Initial schema for Sprint 0 foundation setup

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

