# Netloka Environment Variables
# Copy this file to .env and fill in actual values

# Database Configuration
# Local development uses Docker PostgreSQL (default: postgresql://netloka:netloka_dev_password@localhost:5432/netloka)
DATABASE_URL="postgresql://netloka:netloka_dev_password@localhost:5432/netloka?schema=public"

# Node Environment (development | test | production)
NODE_ENV="development"
