# Zenoba Staging Environment Configuration (new isolated staging only)
# Template for /srv/zenoba/staging/.env (chmod 600)
# Existing Netloka staging requires a separately approved resource/data transition.

# Database Container Configuration
POSTGRES_USER=netloka
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=netloka
NODE_ENV=production

# Database Connection (Docker Compose internal network host 'db:5432')
DATABASE_URL=postgresql://netloka:replace-with-a-long-random-password@db:5432/netloka?schema=public

# Application Authentication Secrets (generate via: openssl rand -base64 32)
AUTH_SECRET=replace-with-a-random-32-character-secret
NEXTAUTH_SECRET=replace-with-a-random-32-character-secret

# Public Application URLs
NEXTAUTH_URL=https://staging.netloka.biz.id
APP_URL=https://staging.netloka.biz.id

# Google OAuth (Optional in staging; leave empty until configured in Google Cloud Console)
# Authorized redirect URI: https://staging.netloka.biz.id/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP Configuration (outgoing hello mailbox; founder is incoming support only)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=hello@zenoba.tech
SMTP_PASSWORD=
EMAIL_FROM=hello@zenoba.tech

# Payment Mode (disabled in staging until Sprint 42)
PAYMENT_MODE=disabled
