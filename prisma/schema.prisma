// Netloka - Prisma Schema
// Updated for Milestone 6: IT Consultant Mode (Sprint 12, 13, & 14)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  LEARNER
  INTERNAL_LEARNER
  DEVELOPER
}

// ====================
// Authentication Models
// ====================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  image          String?
  headline       String?   @default("Siswa SMK TKJ - IT Infrastructure")
  streakCount    Int       @default(1)
  lastStreakDate String?
  role           UserRole  @default(LEARNER)
  authVersion    Int       @default(1)
  lastLoginAt    DateTime?
  lastActiveAt   DateTime?
  twoFactorEnabled     Boolean   @default(false)
  twoFactorSecret      String?
  twoFactorBackupCodes String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts            Account[]
  sessions            Session[]
  progress            UserLessonProgress[]
  xpLedger            UserXpLedger[]
  quizAttempts        QuizAttempt[]
  assessmentAttempts  AssessmentAttempt[]
  labAttempts         LabAttempt[]
  challengeAttempts   ChallengeAttempt[]
  consultantProjects  ConsultantProject[]
  passwordResetTokens PasswordResetToken[]
  orders              Order[]
  entitlements        Entitlement[]
  developerElevationSessions DeveloperElevationSession[]
  learningDrafts      LearningDraft[]
  bookmarks           LessonBookmark[]
  reviewSchedules     ReviewSchedule[]

  @@map("users")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ====================
// Learning Hierarchy Models
// ====================

model LearningPath {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String   @db.Text
  icon        String?
  orderIndex  Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  modules Module[]
  commerceCourse Course?

  @@map("learning_paths")
}

model Module {
  id          String   @id @default(cuid())
  pathId      String
  slug        String
  title       String
  description String   @db.Text
  orderIndex  Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  path    LearningPath @relation(fields: [pathId], references: [id], onDelete: Cascade)
  lessons Lesson[]
  assessmentAttempts AssessmentAttempt[]

  @@unique([pathId, slug])
  @@map("modules")
}

model Lesson {
  id          String   @id @default(cuid())
  moduleId    String
  slug        String
  title       String
  description String   @db.Text
  orderIndex  Int      @default(0)
  xpReward    Int      @default(50)
  content     Json?
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  module        Module               @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  prerequisites LessonPrerequisite[] @relation("LessonToPrerequisites")
  requiredFor   LessonPrerequisite[] @relation("PrerequisiteToLesson")
  userProgress  UserLessonProgress[]
  quizAttempts  QuizAttempt[]
  assessmentAttempts AssessmentAttempt[]

  @@unique([moduleId, slug])
  @@map("lessons")
}

model LessonPrerequisite {
  id             String   @id @default(cuid())
  lessonId       String
  prerequisiteId String
  createdAt      DateTime @default(now())

  lesson       Lesson @relation("LessonToPrerequisites", fields: [lessonId], references: [id], onDelete: Cascade)
  prerequisite Lesson @relation("PrerequisiteToLesson", fields: [prerequisiteId], references: [id], onDelete: Cascade)

  @@unique([lessonId, prerequisiteId])
  @@map("lesson_prerequisites")
}

model UserLessonProgress {
  id          String    @id @default(cuid())
  userId      String
  lessonId    String
  status      String    @default("AVAILABLE") // LOCKED | AVAILABLE | IN_PROGRESS | COMPLETED
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@map("user_lesson_progress")
}

model LearningDraft {
  id             String   @id @default(cuid())
  userId         String
  lessonId       String
  activityId     String
  contentVersion String   @default("1.0")
  payload        Json
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId, activityId])
  @@index([userId, updatedAt])
  @@map("learning_drafts")
}

model LessonBookmark {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId, createdAt])
  @@map("lesson_bookmarks")
}

model ReviewSchedule {
  id                   String    @id @default(cuid())
  userId               String
  outcomeId            String
  dueAt                DateTime
  intervalDays         Int       @default(1)
  consecutiveSuccesses Int       @default(0)
  lastReviewedAt       DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, outcomeId])
  @@index([userId, dueAt])
  @@map("review_schedules")
}

// ====================
// Quiz & Reward Engine Models
// ====================

model UserXpLedger {
  id          String   @id @default(cuid())
  userId      String
  amount      Int
  eventType   String // LESSON_COMPLETION | QUIZ_PASS | PRACTICE_SOLVED | LAB_COMPLETED | CHALLENGE_SOLVED | CONSULTANT_PROJECT_PASSED
  referenceId String // e.g. lessonId, quizId, labId, challengeId, caseId
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventType, referenceId])
  @@index([userId])
  @@map("user_xp_ledger")
}

model QuizAttempt {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  quizId    String
  score     Int
  passed    Boolean
  answers   Json
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([userId, lessonId])
  @@map("quiz_attempts")
}

model AssessmentAttempt {
  id           String   @id @default(cuid())
  userId       String
  assessmentId String
  moduleId     String?
  lessonId     String?
  version      String   @default("1.0")
  score        Int
  passed       Boolean
  answersJson  Json
  requestId    String
  createdAt    DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  module Module? @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  lesson Lesson? @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, requestId])
  @@index([userId, assessmentId])
  @@index([userId, moduleId])
  @@map("assessment_attempts")
}

// ====================
// Lab Engine Models (Sprint 10)
// ====================

model Lab {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  description     String   @db.Text
  category        String // subnetting | ip-config | packet-flow | vlan | routing | dhcp-dns | troubleshooting
  difficulty      String   @default("beginner") // beginner | intermediate | advanced
  initialConfig   Json
  successCriteria Json
  xpReward        Int      @default(100)
  orderIndex      Int      @default(0)
  published       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  attempts LabAttempt[]

  @@map("labs")
}

model LabAttempt {
  id          String   @id @default(cuid())
  userId      String
  labId       String
  score       Int
  passed      Boolean
  state       Json
  submittedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  lab  Lab  @relation(fields: [labId], references: [id], onDelete: Cascade)

  @@index([userId, labId])
  @@map("lab_attempts")
}

// ====================
// Challenge Engine Models (Sprint 11)
// ====================

model Challenge {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String   @db.Text
  scenario    Json
  difficulty  String   @default("intermediate") // beginner | intermediate | advanced
  xpReward    Int      @default(150)
  orderIndex  Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  attempts ChallengeAttempt[]

  @@map("challenges")
}

model ChallengeAttempt {
  id          String   @id @default(cuid())
  userId      String
  challengeId String
  score       Int
  passed      Boolean
  answers     Json
  submittedAt DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@index([userId, challengeId])
  @@map("challenge_attempts")
}

// ====================
// IT Consultant Engine Models (Sprint 12, 13, 14)
// ====================

model ConsultantCase {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  clientName   String
  clientType   String // small-office | warnet | medium-office | school | enterprise
  description  String   @db.Text
  budget       Int // in IDR (Rupiah)
  requirements Json
  constraints  Json
  difficulty   String   @default("intermediate") // beginner | intermediate | advanced
  orderIndex   Int      @default(0)
  published    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  projects ConsultantProject[]

  @@map("consultant_cases")
}

model ConsultantProject {
  id             String   @id @default(cuid())
  userId         String
  caseId         String
  boqItems       Json
  topologyData   Json
  ipPlan         Json
  vlanPlan       Json
  compositeScore Json
  score          Int
  passed         Boolean
  feedback       Json
  submittedAt    DateTime @default(now())

  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  case ConsultantCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([userId, caseId])
  @@map("consultant_projects")
}

// ====================
// Course Commerce Models (Milestone 7 / Sprint 17)
// ====================

model Course {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  track          String   // networking | cctv | fiber-optic | voip | mikrotik | cisco | linux-server | security
  accessTier     String   @default("PREMIUM") // FREE | PREMIUM
  catalogStatus  String   @default("COMING_SOON") // COMING_SOON | AVAILABLE | RETIRED
  description    String?  @db.Text
  orderIndex     Int      @default(0)
  learningPathId String?  @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  learningPath   LearningPath?   @relation(fields: [learningPathId], references: [id], onDelete: SetNull)
  packageCourses PackageCourse[]
  entitlements   Entitlement[]

  @@map("courses")
}

model Package {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  kind          String   // SINGLE | COMBO
  catalogStatus String   @default("COMING_SOON") // COMING_SOON | AVAILABLE | RETIRED
  description   String?  @db.Text
  amountIdr     Int?     // in IDR (Rupiah), null when COMING_SOON
  currency      String   @default("IDR")
  orderIndex    Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  packageCourses PackageCourse[]
  orders         Order[]

  @@map("packages")
}

model PackageCourse {
  packageId  String
  courseId   String
  orderIndex Int      @default(0)
  createdAt  DateTime @default(now())

  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@id([packageId, courseId])
  @@map("package_courses")
}

model Order {
  id             String    @id @default(cuid())
  reference      String    @unique // e.g. ORD-20260904-XXXX
  userId         String
  packageId      String
  state          String    @default("PENDING") // PENDING | PAID | EXPIRED | CANCELLED
  provider       String    @default("SANDBOX") // SANDBOX | MIDTRANS
  totalAmountIdr Int
  currency       String    @default("IDR")
  expiresAt      DateTime
  paidAt         DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  package         Package          @relation(fields: [packageId], references: [id], onDelete: Restrict)
  lines           OrderLine[]
  paymentAttempts PaymentAttempt[]
  entitlements    Entitlement[]

  @@index([userId, state])
  @@map("orders")
}

model OrderLine {
  id          String   @id @default(cuid())
  orderId     String
  itemType    String   // PACKAGE | COURSE
  itemSlug    String
  itemTitle   String
  amountIdr   Int
  currency    String   @default("IDR")
  createdAt   DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_lines")
}

model PaymentAttempt {
  id                String    @id @default(cuid())
  orderId           String
  provider          String    @default("SANDBOX") // SANDBOX | MIDTRANS
  providerReference String?
  state             String    @default("PENDING") // PENDING | SUCCESS | FAILED | EXPIRED
  rawMetadata       Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  order  Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  events PaymentEvent[]

  @@map("payment_attempts")
}

model PaymentEvent {
  id               String    @id @default(cuid())
  paymentAttemptId String
  providerEventId  String    @unique
  eventType        String
  receivedAt       DateTime  @default(now())
  processedAt      DateTime?
  payloadSummary   Json?

  paymentAttempt PaymentAttempt @relation(fields: [paymentAttemptId], references: [id], onDelete: Cascade)

  @@map("payment_events")
}

model Entitlement {
  id         String    @id @default(cuid())
  userId     String
  courseId   String
  orderId    String?
  sourceType String    @default("PURCHASE") // FREE | PURCHASE | ADMIN
  state      String    @default("ACTIVE")   // ACTIVE | REVOKED
  grantedAt  DateTime  @default(now())
  revokedAt  DateTime?
  updatedAt  DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Restrict)
  order  Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([userId, courseId])
  @@index([userId, state])
  @@map("entitlements")
}

// ===================================
// Developer Operations & Audit Models
// ===================================

model DeveloperElevationSession {
  id          String    @id @default(cuid())
  userId      String
  tokenHash   String    @unique
  authVersion Int
  issuedAt    DateTime  @default(now())
  lastUsedAt  DateTime?
  expiresAt   DateTime
  revokedAt   DateTime?
  ipHash      String?
  userAgent   String?   @db.Text
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("developer_elevation_sessions")
}

model DeveloperAuditEvent {
  id            String   @id @default(cuid())
  actorUserId   String?
  targetUserId  String?
  actorKind     String
  action        String
  reason        String?  @db.Text
  requestId     String   @unique
  correlationId String
  beforeState   Json?
  afterState    Json?
  result        String
  createdAt     DateTime @default(now())

  @@index([actorUserId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([action, createdAt])
  @@map("developer_audit_events")
}

model SecurityEvent {
  id        String   @id @default(cuid())
  userId    String?
  type      String
  severity  String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@map("security_events")
}
