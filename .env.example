# Netloka Environment Variables
# Copy this file to .env and fill in actual values

# Database Configuration
# Local development uses Docker PostgreSQL on host port 5433.
DATABASE_URL="postgresql://netloka:netloka_dev_password@localhost:5433/netloka?schema=public"

# Node Environment (development | test | production)
NODE_ENV="development"

# Authentication
# Generate a secure random string for AUTH_SECRET
# Use: openssl rand -base64 32 or node -e "console.log(crypto.randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-to-random-secure-string-here"

# Public application URL used in authentication and password-reset links
APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth Configuration
# In staging/production, configure OAuth 2.0 Web Application credentials in Google Cloud Console.
# Authorized JavaScript Origins: https://staging.netloka.biz.id (or http://localhost:3000 for local test)
# Authorized Redirect URI: https://staging.netloka.biz.id/api/auth/callback/google
# Note: Netloka enforces allowDangerousEmailAccountLinking: false, verified provider emails,
# credentials-first conflict rejection, and blocks DEVELOPER role OAuth logins.
# Leave both empty until OAuth client is explicitly provisioned in isolated staging.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# SMTP Configuration (Hostinger / Operational Mailbox)
# Required for password reset token delivery and operational communications.
# Configure active Hostinger SMTP credentials (e.g. noreply@haikalariadma.my.id).
# Refer to docs/operations/operator-readiness.md and docs/operations/auth-live-verification.md.
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="noreply@haikalariadma.my.id"
SMTP_PASSWORD="replace-with-email-account-password"
EMAIL_FROM="noreply@haikalariadma.my.id"
# Payment / Commerce Configuration (Sprint 42)
# Options: disabled | sandbox | live
# Note: 'live' mode requires separate explicit owner authorization.
PAYMENT_MODE="disabled"
SANDBOX_PAYMENT_EVENT_SECRET="replace-with-sandbox-event-secret"

# Midtrans Configuration (Core API Dynamic QRIS)
# In development/staging, use Sandbox credentials starting with "SB-Mid-server-".
# Refer to docs/operations/midtrans-release-runbook.md for integration details.
MIDTRANS_SERVER_KEY="replace-with-midtrans-server-key"
MIDTRANS_CLIENT_KEY="replace-with-midtrans-client-key"
MIDTRANS_MERCHANT_ID="replace-with-midtrans-merchant-id"
MIDTRANS_IS_PRODUCTION="false"
